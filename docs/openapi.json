          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "shiftDate": {
            "type": "string"
          },
          "shiftType": {
            "type": "integer",
            "format": "int32"
          },
          "createTime": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Result": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
